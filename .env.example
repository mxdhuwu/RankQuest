# ==============================================================================
# RankQuest Production & Local Environment Variables
# ==============================================================================

# 1. Supabase Database Connections (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# 2. Supabase Client Credentials
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Application & Authentication Secrets
JWT_SECRET="generate-a-secure-random-string-for-production"
NEXT_PUBLIC_APP_URL="https://rankquest.vercel.app"
NEXT_PUBLIC_APP_NAME="RankQuest"
